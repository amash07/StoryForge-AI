# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and insert your real Hugging Face access token.
# Get a free read/write token at: https://huggingface.co/settings/tokens
# ==============================================================================

# Your Hugging Face User Access Token (starts with hf_...)
HF_TOKEN=your_huggingface_token_here

# Target Hugging Face Text-to-Image Model
# Options:
#   black-forest-labs/FLUX.1-schnell (Default, high quality & fast)
#   stabilityai/stable-diffusion-xl-base-1.0
#   runwayml/stable-diffusion-v1-5
HF_MODEL=black-forest-labs/FLUX.1-schnell

# Video Output Configuration
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
